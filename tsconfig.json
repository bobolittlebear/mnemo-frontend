{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler", // 【推荐】现代 Vite 项目首选此模式
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path Aliases (替代 baseUrl) */
    "paths": {
      "@/*": ["./src/*"] // 【核心配置】告诉 TS 编译器 @/xxx 对应 ./src/xxx
    }
  },
  "include": ["src", "vite.config.ts"]


}
